   "source": [
    "# Analytical solution for f(x,t) for vanishing relaxation term"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "437fbc27",
   "metadata": {},
   "outputs": [],
   "source": [
    "class Maxwellian:\n",
    "    def __init__(self, rho, v, theta):\n",
    "        self.rho = rho\n",
    "        self.v = v\n",
    "        self.theta = theta\n",
    "\n",
    "    def __call__(self, c):\n",
    "        return self.rho / np.sqrt(2*np.pi*self.theta) * np.exp(-(c-self.v)**2 / (2*self.theta))\n",
    "\n",
    "def f0(f_left, f_right, x, c):\n",
    "    x_arr, c_arr = np.broadcast_arrays(np.asarray(x), np.asarray(c))\n",
    "    return np.where(x_arr < 0, f_left(c_arr), f_right(c_arr))\n",
    "    \n",
    "def f(f_left, f_right, x, c, t):\n",
    "    return f0(f_left, f_right, x - c*t, c)"
   ]
  },
