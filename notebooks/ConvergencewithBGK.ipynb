    "    axs.plot([], [], color='black', linestyle='dotted', label='M={}'.format(M_vector[-1]))\n",
    "    axs.plot([], [], color='black', linestyle='solid', label='BGK')\n",
    "    axs.legend(loc='upper right')\n",
    "\n",
    "    axs.grid(True)\n",
    "\n",
    "    axs.set_xlim(-2., 2.)\n",
